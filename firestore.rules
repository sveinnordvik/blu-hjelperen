rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email in ["svein.nordvik@gmail.com", "sunniva.nordvik2@gmail.com"]);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["svein.nordvik@gmail.com", "sunniva.nordvik2@gmail.com"] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Entity Validations
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() < 255;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['userId', 'title']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() < 255 &&
             (!('folderId' in data) || data.folderId is string || data.folderId == null) &&
             (!('content' in data) || data.content is string || data.content is map);
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['userId', 'name']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 255;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId == request.auth.uid &&
             (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 100)) &&
             (!('progress' in data) || (data.progress is list && data.progress.size() <= 50));
    }

    function isValidChatHistory(data) {
      return data.keys().hasAll(['messages']) &&
             data.messages is list && data.messages.size() <= 500;
    }

    function isValidContextFile(data) {
      return data.keys().hasAll(['userId', 'name', 'type']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             data.type in ['file', 'folder'] &&
             (!('content' in data) || data.content is string) &&
             (!('folderId' in data) || data.folderId is string || data.folderId == null) &&
             (!('isPinned' in data) || data.isPinned is bool);
    }

    function isValidPedagogicalDocumentation(data) {
      return data.keys().hasAll(['content', 'type', 'timestamp']) &&
             data.content is string && data.content.size() > 0 &&
             data.type in ['daily', 'monthly'] &&
             (!('monthFolder' in data) || data.monthFolder is string) &&
             (!('adminId' in data) || data.adminId is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidGroup(data) {
      return (('name' in data && data.name is string) || ('groupName' in data && data.groupName is string)) &&
             (!('sharedRagContext' in data) || data.sharedRagContext is string) &&
             (!('flashcards' in data) || data.flashcards is list) &&
             (!('messages' in data) || data.messages is list) &&
             (!('notes' in data) || data.notes is string) &&
             (!('todos' in data) || data.todos is list) &&
             (!('files' in data) || data.files is list) &&
             (!('events' in data) || data.events is list) &&
             (!('members' in data) || data.members is list) &&
             (!('userProgress' in data) || data.userProgress is map);
    }

    function isValidProcessLog(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId == request.auth.uid &&
             (!('situation' in data) || (data.situation is string && data.situation.size() <= 20000)) &&
             (!('reflection' in data) || (data.reflection is string && data.reflection.size() <= 20000)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 500)) &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500)) &&
             (!('folderId' in data) || data.folderId is string || data.folderId == null) &&
             (!('folderName' in data) || data.folderName is string || data.folderName == null) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 200)) &&
             (!('documentId' in data) || (data.documentId is string && data.documentId.size() <= 200)) &&
             (!('documentTitle' in data) || (data.documentTitle is string && data.documentTitle.size() <= 500)) &&
             (!('sources' in data) || (data.sources is string && data.sources.size() <= 5000)) &&
             (!('theoryLinks' in data) || (data.theoryLinks is string && data.theoryLinks.size() <= 5000)) &&
             (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt == null) &&
             (!('isPinned' in data) || data.isPinned is bool);
    }

    function isValidFieldNote(data) {
      return data.keys().hasAll(['userId', 'title', 'content']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 500 &&
             data.content is string && data.content.size() <= 50000 &&
             (!('category' in data) || data.category is string) &&
             (!('tags' in data) || data.tags is list);
    }

    function isValidSharedReview(data) {
      return data.keys().hasAll(['id', 'authorId', 'title', 'content']) &&
             data.id is string && data.id.size() > 0 &&
             data.authorId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.content is string && data.content.size() <= 100000 &&
             (!('comments' in data) || data.comments is list) &&
             (!('allowComments' in data) || data.allowComments is bool) &&
             (!('isClosed' in data) || data.isClosed is bool);
    }

    function isValidPresentation(data) {
      return data.keys().hasAll(['userId', 'title']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             (!('folderId' in data) || data.folderId is string || data.folderId == null) &&
             (!('slides' in data) || data.slides is list);
    }

    function isValidCompletedChecklist(data) {
      return data.keys().hasAll(['templateId', 'title', 'department', 'completedAt', 'completedBy', 'status', 'frozenContent']) &&
             data.templateId is string &&
             data.title is string &&
             data.department is string &&
             data.completedAt is string &&
             data.completedBy is map &&
             data.status in ['ok', 'avvik'] &&
             data.frozenContent is list;
    }

    function isValidHMSAvvik(data) {
      return data.keys().hasAll(['tittel', 'beskrivelse', 'base', 'status']) &&
             data.tittel is string &&
             data.beskrivelse is string &&
             data.base is string &&
             data.status in ['Åpen', 'Under utbedring', 'Lukket'];
    }

    function isValidChecklistTemplate(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string;
    }

    function isValidActiveTask(data) {
      return data.keys().hasAll(['templateId', 'title', 'base', 'status']) &&
             data.templateId is string &&
             data.title is string &&
             data.base is string;
    }

    function isValidLiteratureDocument(data) {
      return (('title' in data && data.title is string) || ('tittel' in data && data.tittel is string)) &&
             (('authors' in data && data.authors is list) || ('forfattere' in data && data.forfattere is list)) &&
             (('year' in data && (data.year is int || data.year is number)) || ('utgivelsesår' in data && (data.utgivelsesår is int || data.utgivelsesår is number)) || ('utgivelsesar' in data && (data.utgivelsesar is int || data.utgivelsesar is number))) &&
             (('sourceType' in data && data.sourceType is string) || ('kildetype' in data && data.kildetype is string)) &&
             (('access' in data && data.access is string) || ('tilgang' in data && data.tilgang is string));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        isAdmin() || 
        // Action: standard profile and app state sync
        (incoming().diff(existing()).affectedKeys().hasOnly(['profile', 'pedagogicalProfile', 'hasCompletedOnboarding', 'notificationSettings', 'theme', 'settings', 'notificationsEnabled', 'onboardingComplete', 'lowStressMode', 'activeTab', 'writingStep', 'selectedReferenceStyle', 'aiTerms', 'searchCounts', 'updatedAt', 'pricingTier', 'humanizerCredits', 'referredBy', 'documents', 'folders', 'fcmToken', 'name', 'uid', 'email']))
      );
      allow delete: if isOwner(userId) || isAdmin();
      
      // We don't allow listing users at top level for PII privacy
      allow list: if false;

      // Subcollection for private literature silo (pensum / opphavsrettsbeskyttet)
      match /litteratur/{documentId} {
        allow read, write: if isOwner(userId);
        match /chunks/{chunkId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Subcollection for chats / chat messages (GDPR & Chat History)
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
        match /{document=**} {
          allow read, write: if isOwner(userId);
        }
      }

      match /superveileder_chats/{chatId} {
        allow read, write: if isOwner(userId);
        match /{document=**} {
          allow read, write: if isOwner(userId);
        }
      }

      match /documents/{docId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDocument(incoming());
        allow update: if isOwner(userId) && isValidDocument(incoming()) && 
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /projects/{projectId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidProject(incoming()) &&
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /chatHistory/{chatId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidChatHistory(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /process_logs/{logId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /context_files/{fileId} {
      // Secure List Queries Pattern
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidContextFile(incoming());
      allow update: if isSignedIn() && isValidContextFile(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /pedagogical_documentation/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidPedagogicalDocumentation(incoming());
    }

    match /admins/{adminId} {
      // Only admins can see who else is an admin
      allow read: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidGroup(incoming());
      allow update: if isSignedIn() && isValidGroup(incoming());
      allow delete: if isSignedIn() || isAdmin();
    }

    match /processLogs/{logId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidProcessLog(incoming());
      allow update: if isSignedIn() && isValidProcessLog(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /documents/{docId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidDocument(incoming());
      allow update: if isSignedIn() && isValidDocument(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /folders/{folderId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidFolder(incoming());
      allow update: if isSignedIn() && isValidFolder(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /fieldNotes/{noteId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidFieldNote(incoming());
      allow update: if isSignedIn() && isValidFieldNote(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /shared_reviews/{reviewId} {
      // Anyone with the share link can read the shared peer review document
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidSharedReview(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if (isSignedIn() && existing().authorId == request.auth.uid && isValidSharedReview(incoming())) ||
                    (existing().allowComments == true && (!('isClosed' in existing()) || existing().isClosed == false) && isValidSharedReview(incoming()));
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    match /presentations/{presId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPresentation(incoming());
      allow update: if isSignedIn() && isValidPresentation(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /completed_checklists/{checklistId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidCompletedChecklist(incoming());
      allow delete: if isAdmin();
    }

    match /hms_avvik/{avvikId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidHMSAvvik(incoming());
      allow delete: if isAdmin();
    }

    match /checklists_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /departments/{depId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /active_tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    match /itp_templates/{templateId} {
      allow read, write: if isSignedIn();
    }

    match /barnehage_innstillinger/{docId} {
      allow read, write: if isSignedIn();
    }

    // Shared Open Access literature archive
    match /felles_litteratur/{documentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidLiteratureDocument(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Norwegian path alias for user private literature
    match /brukere/{userId} {
      allow read, write: if isOwner(userId);
      match /litteratur/{documentId} {
        allow read, write: if isOwner(userId);
        match /chunks/{chunkId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}
