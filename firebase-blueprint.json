{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "pricingTier": {
          "type": "string",
          "enum": [
            "free",
            "monthly",
            "semester",
            "preview"
          ]
        },
        "profile": {
          "type": "object"
        },
        "pedagogicalProfile": {
          "type": "object"
        },
        "hasCompletedOnboarding": {
          "type": "boolean"
        },
        "notificationSettings": {
          "type": "object"
        },
        "fcmToken": {
          "type": "string"
        },
        "humanizerCredits": {
          "type": "number",
          "description": "Available credits for Humanizer-bot washes"
        },
        "referredBy": {
          "type": "string",
          "description": "UID of the student who referred this user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "Document": {
      "title": "Document",
      "description": "User's active writing documents",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "content": {
          "type": "object"
        },
        "activeDisposition": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title"
      ]
    },
    "Folder": {
      "title": "Folder",
      "description": "User folders for organizing writing documents",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isExpanded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name"
      ]
    },
    "Project": {
      "title": "Project",
      "description": "User's project data including milestones and progress",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "milestones": {
          "type": "array"
        },
        "progress": {
          "type": "array"
        },
        "checklist": {
          "type": "array"
        },
        "outline": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId"
      ]
    },
    "ContextFile": {
      "title": "ContextFile",
      "description": "User's context files and folders for analysis",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "file",
            "folder"
          ]
        },
        "userId": {
          "type": "string"
        },
        "isPinned": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "type"
      ]
    },
    "ChatHistory": {
      "title": "ChatHistory",
      "description": "User's chat messages with Assistant",
      "type": "object",
      "properties": {
        "messages": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "messages"
      ]
    },
    "PedagogicalDocumentation": {
      "title": "PedagogicalDocumentation",
      "description": "Daily and monthly pedagogical texts",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "daily",
            "monthly"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "adminId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "monthFolder": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "type",
        "timestamp"
      ]
    },
    "Group": {
      "title": "Group",
      "description": "Collaboration group containing members, shared Rag context, flashcards, files, events, todos, and chat",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "groupName": {
          "type": "string"
        },
        "sharedRagContext": {
          "type": "string"
        },
        "flashcards": {
          "type": "array"
        },
        "userProgress": {
          "type": "object"
        },
        "messages": {
          "type": "array"
        },
        "notes": {
          "type": "string"
        },
        "todos": {
          "type": "array"
        },
        "files": {
          "type": "array"
        },
        "events": {
          "type": "array"
        },
        "members": {
          "type": "array"
        },
        "activity": {
          "type": "array"
        },
        "meetingLink": {
          "type": "string"
        },
        "calendarLink": {
          "type": "string"
        },
        "unreadChat": {
          "type": "boolean"
        },
        "isDemo": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProcessLog": {
      "title": "ProcessLog",
      "description": "Student pedagogical process logs and reflections",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        },
        "reflection": {
          "type": "string"
        },
        "theoryLinks": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        },
        "isPinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId"
      ]
    },
    "FieldNote": {
      "title": "FieldNote",
      "description": "User field notes from Kladdablokk",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "content"
      ]
    },
    "SharedReview": {
      "title": "SharedReview",
      "description": "Shared document for peer review with comments in margin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "docId": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "taskPrompt": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "allowComments": {
          "type": "boolean"
        },
        "isClosed": {
          "type": "boolean"
        },
        "comments": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "authorId",
        "title",
        "content"
      ]
    },
    "Presentation": {
      "title": "Presentation",
      "description": "User presentations with slides, theme and script",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "sourceText": { "type": "string" },
        "targetAudience": { "type": "string" },
        "slideCountOption": { "type": "string" },
        "folderId": { "type": "string" },
        "slides": { "type": "array" },
        "themeId": { "type": "string" },
        "globalBackground": { "type": "string" },
        "globalDim": { "type": "number" },
        "globalBlur": { "type": "boolean" },
        "brandingSettings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title"
      ]
    },
    "CompletedChecklist": {
      "title": "CompletedChecklist",
      "description": "Frozen completed HMS checklist document with locked timestamps, inspector identity, frozen questions array, and linked deviation ID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "title": { "type": "string" },
        "department": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "completedBy": {
          "type": "object",
          "properties": {
            "uid": { "type": "string" },
            "name": { "type": "string" }
          },
          "required": ["uid", "name"]
        },
        "status": {
          "type": "string",
          "enum": ["ok", "avvik"]
        },
        "frozenContent": {
          "type": "array",
          "description": "Array of frozen checklist questions, check statuses, and notes"
        },
        "deviationId": {
          "type": "string",
          "description": "ID of created deviation if status is avvik, or null if ok"
        }
      },
      "required": [
        "templateId",
        "title",
        "department",
        "completedAt",
        "completedBy",
        "status",
        "frozenContent"
      ]
    },
    "HMSAvvik": {
      "title": "HMSAvvik",
      "description": "HMS deviation record reported from checklists or direct entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tittel": { "type": "string" },
        "beskrivelse": { "type": "string" },
        "base": { "type": "string" },
        "meldtAv": { "type": "string" },
        "dato": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Åpen", "Under utbedring", "Lukket"]
        },
        "alvorlighetsgrad": {
          "type": "string",
          "enum": ["Høy", "Middels", "Lav"]
        },
        "checklistId": { "type": "string" },
        "kommentarer": { "type": "array" }
      },
      "required": ["tittel", "beskrivelse", "base", "status"]
    },
    "ChecklistTemplate": {
      "title": "ChecklistTemplate",
      "description": "Checklist template definition with custom dispatch and due times",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "frequency": { "type": "string" },
        "activeDays": { "type": "array" },
        "dispatchTime": { "type": "string" },
        "dueTime": { "type": "string" },
        "questions": { "type": "array" }
      },
      "required": ["title"]
    },
    "Department": {
      "title": "Department",
      "description": "Kindergarten department or base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "ActiveTask": {
      "title": "ActiveTask",
      "description": "Active scheduled task / checklist pending completion by staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "title": { "type": "string" },
        "base": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "Utført", "Venter"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "snapshot": { "type": "array" }
      },
      "required": ["templateId", "title", "base", "status"]
    },
    "LiteratureDocument": {
      "title": "LiteratureDocument",
      "description": "Academic literature document for private curriculum or shared open access archive",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "array" },
        "year": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceType": { "type": "string" },
        "access": { "type": "string", "enum": ["privat", "felles"] },
        "userId": { "type": "string" },
        "fileUrl": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["title", "authors", "year", "sourceType", "access"]
    },
    "SpecialEducationCase": {
      "title": "SpecialEducationCase",
      "description": "Special education case tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseCode": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["Samtykke innhentet", "Henvisning sendt PPT", "Vedtak mottatt", "ITP opprettet", "Halvårsrapport levert"] },
        "deadline": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caseCode", "department", "status"]
    }
  },
  "firestore": {
    "/users/{userId}/litteratur/{documentId}": {
      "schema": "LiteratureDocument",
      "description": "User's private copyrighted literature silo"
    },
    "/brukere/{userId}/litteratur/{documentId}": {
      "schema": "LiteratureDocument",
      "description": "User's private copyrighted literature silo (Norwegian path alias)"
    },
    "/felles_litteratur/{documentId}": {
      "schema": "LiteratureDocument",
      "description": "Shared Open Access academic literature archive"
    },
    "/special_education_cases/{caseId}": {
      "schema": "SpecialEducationCase",
      "description": "Special education cases"
    },
    "/checklists_templates/{templateId}": {
      "schema": "ChecklistTemplate",
      "description": "Checklist templates"
    },
    "/departments/{depId}": {
      "schema": "Department",
      "description": "Kindergarten departments"
    },
    "/active_tasks/{taskId}": {
      "schema": "ActiveTask",
      "description": "Active scheduled tasks and closing checklists"
    },
    "/completed_checklists/{checklistId}": {
      "schema": "CompletedChecklist",
      "description": "Frozen completed HMS checklists archive"
    },
    "/hms_avvik/{avvikId}": {
      "schema": "HMSAvvik",
      "description": "Registered HMS deviations"
    },
    "/presentations/{presId}": {
      "schema": "Presentation",
      "description": "User presentations with slides and speaker notes"
    },
    "/shared_reviews/{reviewId}": {
      "schema": "SharedReview",
      "description": "Shared peer review documents and margin comments"
    },
    "/fieldNotes/{noteId}": {
      "schema": "FieldNote",
      "description": "User field notes and kladdablokk entries"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "User writing documents and assignments"
    },
    "/folders/{folderId}": {
      "schema": "Folder",
      "description": "User folders for document organization"
    },
    "/processLogs/{logId}": {
      "schema": "ProcessLog",
      "description": "User pedagogical process logs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": "Document",
      "description": "User's writing documents"
    },
    "/users/{userId}/chatHistory/main": {
      "schema": "ChatHistory",
      "description": "User's main chat history"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatHistory",
      "description": "User's BLU-hjelper chat sessions and messages"
    },
    "/users/{userId}/superveileder_chats/{chatId}": {
      "schema": "ChatHistory",
      "description": "User's Superveileder chat sessions and messages"
    },
    "/users/{userId}/projects/main": {
      "schema": "Project",
      "description": "User's main project state"
    },
    "/context_files/{fileId}": {
      "schema": "ContextFile",
      "description": "User's uploaded context files and folders"
    },
    "/pedagogical_documentation/{docId}": {
      "schema": "PedagogicalDocumentation",
      "description": "Pedagogical documentation archive"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Collaboration groups"
    }
  }
}