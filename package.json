    "@tiptap/starter-kit": "^3.22.4",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
