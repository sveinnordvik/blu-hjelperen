// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - name: string (optional) - User's full name
//   - email: string (required) - User's email address
//   - pricingTier: string (optional) - Subscription level (free, monthly, semester, preview)
//   - profile: map (optional) - Student profile details
//   - notificationSettings: map (optional) - User's notification preferences
//   - fcmToken: string (optional) - Firebase Cloud Messaging token
//   - createdAt: timestamp (optional) - Document creation time
//   - updatedAt: timestamp (optional) - Document last update time
//
// Collection: users/{userId}/documents
// Document ID: {docId}
// Fields:
//   - id: string (optional) - Document ID
//   - userId: string (required) - Owner's UID
//   - title: string (required) - Document title
//   - content: map (optional) - Document content sections
//   - activeDisposition: list (optional) - Current document structure
//   - createdAt: timestamp (optional) - Creation time
//   - updatedAt: timestamp (optional) - Last update time
//
// Collection: users/{userId}/projects
// Document ID: main
// Fields:
//   - userId: string (required) - Owner's UID
//   - milestones: list (optional) - Project milestones
//   - progress: list (optional) - Project progress steps
//   - checklist: list (optional) - Project checklist items
//   - outline: list (optional) - Project outline structure
//   - updatedAt: timestamp (optional) - Last update time
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "svein.nordvik@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() < 255;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['userId', 'title']) &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() < 255;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId == request.auth.uid;
    }

    function isValidContextFile(data) {
      return data.keys().hasAll(['userId', 'name', 'type']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             data.type in ['file', 'folder'] &&
             (!('content' in data) || data.content is string) &&
             (!('folderId' in data) || data.folderId is string || data.folderId == null);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    request.resource.data.uid == resource.data.uid &&
                    (request.resource.data.role == resource.data.role || isAdmin());

      match /documents/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidDocument(request.resource.data);
        allow update: if isOwner(userId) && isValidDocument(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /projects/{projectId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidProject(request.resource.data);
        allow update: if isOwner(userId) && isValidProject(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /context_files/{fileId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidContextFile(request.resource.data);
      allow update: if isAuthenticated() && isValidContextFile(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
