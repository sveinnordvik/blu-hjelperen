{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "pricingTier": { "type": "string", "enum": ["free", "monthly", "semester", "preview"] },
        "profile": { "type": "object" },
        "notificationSettings": { "type": "object" },
        "fcmToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Document": {
      "title": "Document",
      "description": "User's active writing documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "object" },
        "activeDisposition": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "Project": {
      "title": "Project",
      "description": "User's project data including milestones and progress",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "milestones": { "type": "array" },
        "progress": { "type": "array" },
        "checklist": { "type": "array" },
        "outline": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "ContextFile": {
      "title": "ContextFile",
      "description": "User's context files and folders for analysis",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "folderId": { "type": "string" },
        "type": { "type": "string", "enum": ["file", "folder"] },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": "Document",
      "description": "User's writing documents"
    },
    "/users/{userId}/projects/main": {
      "schema": "Project",
      "description": "User's main project state"
    },
    "/context_files/{fileId}": {
      "schema": "ContextFile",
      "description": "User's uploaded context files and folders"
    }
  }
}
